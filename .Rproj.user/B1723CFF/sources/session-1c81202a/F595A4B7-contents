#per trovare il numero ottimale di clusters
library(ggplot2)

# Funzione per calcolare la somma delle distanze intra-cluster (WSS) per diversi k
elbow_method <- function(dtm_matrix, max_k = 10) {
  wss <- numeric(max_k)  # Vettore per salvare la WSS
  
  for (k in 1:max_k) {
    set.seed(42)
    kmeans_result <- kmeans(dtm_matrix, centers = k, nstart = 10)
    wss[k] <- kmeans_result$tot.withinss  # Somma delle distanze intra-cluster
  }
  
  # Plot del metodo del gomito
  qplot(1:max_k, wss, geom = "line") +
    geom_point() +
    labs(title = "Elbow Method for K-Means", x = "Number of Clusters (k)", y = "Within-cluster Sum of Squares") +
    theme_minimal()
}

# Applicazione del metodo del gomito sulla matrice DTM
elbow_method(dtm_matrix, max_k = 20)

# Applicazione del clustering k-means
set.seed(42)
kmeans_result <- kmeans(dtm_matrix, centers = 6) #qui specifichiamo quanti centroidi usare nel modello
print(kmeans_result$cluster)
dtm_matrix

#quali sono i top word types per ogni cluster?
# Assegna i cluster ai documenti
clusters <- kmeans_result$cluster

# Trova i top terms per cluster
top_terms_per_cluster <- function(dtm_matrix, clusters, top_n = 5) {
  cluster_terms <- aggregate(dtm_matrix, by = list(cluster = clusters), FUN = mean)
  cluster_terms <- cluster_terms[, -1]  # Rimuove la colonna dei cluster
  
  top_terms <- apply(cluster_terms, 1, function(x) {
    names(sort(x, decreasing = TRUE)[1:top_n])  # Prendi i primi N termini per media più alta
  })
  
  return(top_terms)
}

top_terms <- top_terms_per_cluster(dtm_matrix, clusters)
print(top_terms)

# In che relazione sono i cluster? Per capirlo usiamo hierarchical clustering
# Calcola la distanza euclidea tra i documenti
distance_matrix <- dist(dtm_matrix, method = "euclidean")

# Creazione del dendrogramma con clustering gerarchico (metodo ward.D2)
hclust_result <- hclust(distance_matrix, method = "ward.D2")

# Plot del dendrogramma
plot(hclust_result, main = "Hierarchical Clustering Dendrogram", xlab = "documents", sub = "", cex = TRUE)


# Taglia il dendrogramma per ottenere 5 cluster
cutree_clusters <- cutree(hclust_result, k = 10)

# Mostra il numero di documenti per cluster
table(cutree_clusters)

