# STILOMETRIA
############################################################
# installa e carica il pacchetto stylo
install.packages("stylo")
library(stylo)

# La stilometria serve per analizzare le caratteristiche stilistiche dei testi
# e può essere usata, ad esempio, per identificare autori o confrontare stili di scrittura

# Supponiamo di voler fare un'analisi stilometrica sul nostro dataset di testi
# Creiamo un corpus temporaneo con i testi etichettati per classe
corpus_stylo <- data.frame(
  text = df$text,
  class = df$class
)

# Salviamo i testi in cartelle separate per classe, come richiesto da stylo
dir.create("stylo_corpus")
dir.create("stylo_corpus/nonsuicide")
dir.create("stylo_corpus/suicide")

# Scriviamo i file di testo in cartelle separate
for (i in 1:nrow(corpus_stylo)) {
  class_dir <- paste0("stylo_corpus/", corpus_stylo$class[i])
  writeLines(corpus_stylo$text[i], paste0(class_dir, "/text_", i, ".txt"))
}

# Analisi stilometrica di base
# stylo() analizza i testi nella directory di lavoro per identificare pattern linguistici



setwd("stylo_corpus")

results <- stylo(
  gui = FALSE,               # disattiva l'interfaccia grafica
  corpus.dir = ".",          # directory del corpus
  mfw = 500,                 # most frequent words
  analysis.type = "CA",      # analisi delle corrispondenze (puoi usare anche "BCT" o "PCR")
  sampling = "no.sampling"   # usa i testi interi
)

