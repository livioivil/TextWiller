list.files("inst/apps/textwiller_app", full.names = TRUE, pattern = "\\.R$")
)
text <- sapply(files, readLines, warn = FALSE)
names(text) <- basename(files)
collapsed <- paste(
mapply(function(name, code) paste0("\n\n### FILE: ", name, "\n", paste(code, collapse = "\n")), names(text), text),
collapse = "\n"
)
writeLines(collapsed, "TextWiller_consolidated.R")
