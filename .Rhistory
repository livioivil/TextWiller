library(caret)
library(randomForest)
library(e1071)
library(tm)
library(tidyverse)
# Carica il dataset e campiona 500 righe casualmente
df <- read.csv('corpora/Suicide_Detection.csv')
df <- df[sample(nrow(df), 500), ]
df
View(df)
df$class <- gsub("non-suicide", "nonsuicide", df$class)
corpus <- Corpus(VectorSource(df$text))
corpus <- tm_map(corpus, content_transformer(tolower))  # Converti in minuscolo
corpus <- tm_map(corpus, removePunctuation)  # Rimuovi punteggiatura
corpus <- tm_map(corpus, removeNumbers)  # Rimuovi numeri
corpus <- tm_map(corpus, removeWords, stopwords("en"))  # Rimuovi stopwords
corpus <- tm_map(corpus, stripWhitespace)  # Rimuovi spazi bianchi extra
# Creazione della matrice di occorrenze
dtm <- DocumentTermMatrix(corpus)
View(dtm)
# Converti la matrice in dataframe e assegna le classi
data <- as.data.frame(as.matrix(dtm))
View(data)
colnames(data) <- make.names(colnames(data))  # Rendi i nomi di colonna validi
data$class <- factor(df$class)  # Assicura che 'class' sia un fattore
data$class
# Divisione dei dati in training (75%) e test (25%)
trainIndex <- createDataPartition(data$class, p = .80, list = FALSE)
data_train <- data[trainIndex, ]
data_test <- data[-trainIndex, ]
data_train
# Divisione dei dati in training (75%) e test (25%)
trainIndex <- createDataPartition(data$class, p = .75, list = FALSE)
data_train <- data[trainIndex, ]
data_test <- data[-trainIndex, ]
colnames(data_train) <- make.names(colnames(data_train), unique = TRUE)
print(table(data_train$class))
print(table(data_test$class))
# Controllo della procedura di cross-validation
fitControl <- trainControl(method = "cv", number = 2, classProbs = TRUE, returnResamp = "all")
# Addestramento del modello SVM - Support Vector Machines
SVM <- train(class ~ ., data = data_train, method = "svmPoly",
preProcess = c("center", "scale"),
trControl = fitControl, tuneLength = 3, importance = TRUE)
confusionMatrix(SVM, "average")
plot(SVM)
# Addestramento del modello Random Forest
RF <- train(class ~ ., data = data_train, method = "rf",
preProcess = c("center", "scale"),
trControl = fitControl, tuneLength = 3, importance = TRUE)
confusionMatrix(RF, "average")
