cat(sprintf("   %-25s: %s\n", func, status))
}
# Verifica dizionari
cat("\n2. VERIFICA DIZIONARI:\n")
dictionaries <- c(
"stopwords_ita", "vocabolarioMattivio", "vocabolariMadda",
"dizionario_sentiment_ita", "dizionario_nomi_propri", "dizionario_luoghi"
)
for (dict in dictionaries) {
exists_dict <- exists(dict)
status <- ifelse(exists_dict, "✓ CARICATO", "✗ MANCANTE")
cat(sprintf("   %-25s: %s\n", dict, status))
}
# Test funzionalità sentiment
cat("\n3. TEST SENTIMENT ANALYSIS:\n")
test_text <- c("buono", "cattivo", "neutro")
tryCatch({
if (exists("sentiment")) {
result <- sentiment(test_text)
cat("   sentiment() funziona:", paste(result, collapse=", "), "\n")
} else {
cat("   sentiment() non disponibile\n")
}
}, error = function(e) {
cat("   sentiment() errore:", e$message, "\n")
})
cat("\n=== FINE DIAGNOSTICA ===\n")
